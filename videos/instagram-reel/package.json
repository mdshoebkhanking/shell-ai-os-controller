{
  "name": "shell-ai-current-ui-video",
  "version": "1.0.0",
  "private": true,
  "description": "16:9 Remotion demo for the current Shell AI OS Controller UI.",
  "license": "Apache-2.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "npm run still:landscape",
    "render": "npm run render:landscape",
    "still:landscape": "remotion still src/index.ts ShellCurrentUiLandscape --frame=42 --output=../shell-current-ui-landscape-poster.png",
    "render:landscape": "remotion render src/index.ts ShellCurrentUiLandscape ../shell-current-ui-landscape-demo.mp4 --codec=h264 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/cli": "4.0.462",
    "@remotion/media": "4.0.462",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "4.0.462"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
