# ==============================================
# SHELL AI v1.0 — ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your API keys.
# Only CRITICAL keys are required — everything else is optional.

# ──────────────────────────────────────────────
# [1] LIVEKIT CONFIGURATION (CRITICAL — Voice)
# ──────────────────────────────────────────────
# Get from: https://cloud.livekit.io/
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# ──────────────────────────────────────────────
# [2] GOOGLE GEMINI (CRITICAL — Primary Brain)
# ──────────────────────────────────────────────
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Gemini model settings
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_TEMPERATURE=0.8
GEMINI_API_VERSION=v1alpha

# ──────────────────────────────────────────────
# [3] VOICE & TTS SETTINGS
# ──────────────────────────────────────────────
# VOICE_NAME: any of the 30 Gemini 2.5 native-audio prebuilt voices.
#   Female: Achernar, Aoede (default), Autonoe, Callirrhoe, Despina,
#           Erinome, Gacrux, Kore, Laomedeia, Leda, Pulcherrima, Sulafat,
#           Vindemiatrix, Zephyr
#   Male:   Achird, Algenib, Algieba, Alnilam, Charon, Enceladus, Fenrir,
#           Iapetus, Orus, Puck, Rasalgethi, Sadachbia, Sadaltager, Schedar,
#           Umbriel, Zubenelgenubi
VOICE_NAME=Aoede
# VOICE_PERSONA: Hinglish | English | English-Indian | Hindi | Formal | Casual
VOICE_PERSONA=Hinglish
DISABLE_TTS=0
FORCE_REALTIME_VOICE=1
ALLOW_LOCAL_TTS=1
LOCAL_TTS_MIRROR=0

# ──────────────────────────────────────────────
# [4] AUDIO DEVICE ROUTING (Optional)
# ──────────────────────────────────────────────
# Run with SHELL_LIST_AUDIO_DEVICES=1 to see available devices
# SHELL_INPUT_DEVICE=Microphone (Realtek(R) Audio)
# SHELL_OUTPUT_DEVICE=Speakers (Realtek(R) Audio)
SHELL_AUTO_AVOID_VIRTUAL_MIC=1
SHELL_AUTO_AVOID_VIRTUAL_OUTPUT=1
SHELL_LIST_AUDIO_DEVICES=0
SHELL_AUTO_TEXT_ON_NO_INPUT=1
SHELL_CONSOLE_TEXT_MODE=0

# ──────────────────────────────────────────────
# [5] VAD (Voice Activity Detection) Tuning
# ──────────────────────────────────────────────
TURN_DETECTION_MODE=server_endpointing
MIN_ENDPOINTING_DELAY_SEC=0.5
MAX_ENDPOINTING_DELAY_SEC=5.0
ALLOW_INTERRUPTIONS=1
VAD_ACTIVATION_THRESHOLD=0.58
VAD_DEACTIVATION_THRESHOLD=0.46
VAD_MIN_SPEECH_SEC=0.12
VAD_MIN_SILENCE_SEC=0.75
VAD_PREFIX_PADDING_SEC=0.35
VAD_MAX_BUFFER_SEC=45
VAD_SAMPLE_RATE=16000

# ──────────────────────────────────────────────
# [6] GOOGLE SEARCH (Optional — Internet Access)
# ──────────────────────────────────────────────
# Get from: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# ──────────────────────────────────────────────
# [7] WEATHER API (Optional)
# ──────────────────────────────────────────────
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=
TAVILY_API_KEY=

# ──────────────────────────────────────────────
# [8] MULTI-AI BRAIN KEYS (All Optional)
# ──────────────────────────────────────────────
# OpenAI GPT-4o — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenRouter OpenAI-compatible routing — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral AI — https://console.mistral.ai/
MISTRAL_API_KEY=

# Groq (Fast Inference) — https://console.groq.com/
GROQ_API_KEY=

# Blackbox AI
BLACKBOX_API_KEY=

# ──────────────────────────────────────────────
# [9] OTHER OPTIONAL APIs
# ──────────────────────────────────────────────
# HuggingFace (Image Generation)
HF_API_KEY=
# Alias supported by older modules:
HUGGINGFACE_API_KEY=

# News API — https://newsapi.org/
NEWS_API_KEY=

# ──────────────────────────────────────────────
# [10] EMAIL AUTOMATION (Optional)
# ──────────────────────────────────────────────
SHELL_SMTP_SERVER=smtp.gmail.com
SHELL_SMTP_PORT=587
SHELL_SMTP_USE_SSL=false
SHELL_SENDER_EMAIL=
SHELL_SENDER_PASSWORD=
SHELL_SENDER_NAME=
SHELL_SENDER_ROLE=
SHELL_SENDER_COMPANY=

# Gmail Web fallback
SHELL_GMAIL_WEB_PROFILE_DIR=~/.shell_gmail_chrome
SHELL_EMAIL_WEB_FALLBACK=true

# ──────────────────────────────────────────────
# [11] SOCIAL MEDIA (Optional)
# ──────────────────────────────────────────────
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
TELEGRAM_BOT_TOKEN=
AUTO_START_TELEGRAM_BOT=0

# ──────────────────────────────────────────────
# [12] SHELL INFRASTRUCTURE SETTINGS
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
SHELL_AUTO_DISCOVER=0
# Public release guard. Keep off for local development. Set to 1 only in
# packaged release validation; unsafe automation flags will then block launch.
SHELL_PRODUCTION_MODE=0
SHELL_PUBLIC_RELEASE=0
# SHELL_HUB_URL=http://127.0.0.1:5000
# SHELL_HUB_PORT=5000
SHELL_AGENT_MODE=console

# ──────────────────────────────────────────────
# [12A] SHELLAI CORE / AI OS FABRIC (Optional)
# ──────────────────────────────────────────────
# Classic desktop behavior stays active unless this is explicitly changed.
# Use shellai_core only when you want PyQt chat text routed through ShellAI Core.
SHELLAI_BACKEND_MODE=classic

# Optional config override. Default is ~/.shellai/config.json.
# SHELLAI_CONFIG=~/.shellai/config.json

# Model routing for `python -m shellai`:
#   openai      -> OPENAI_API_KEY
#   openrouter  -> OPENROUTER_API_KEY
#   ollama      -> local Ollama server, no API key
SHELLAI_PROVIDER=openai
SHELLAI_MODEL_PLANNING=gpt-4o-mini
SHELLAI_MODEL_COMMAND=gpt-4o-mini
SHELLAI_MODEL_SUMMARIZATION=gpt-4o-mini
SHELLAI_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional local daemon queue. It only processes explicitly enqueued tasks.
SHELLAI_DAEMON_ENABLED=0

# UI settings
UI_LOCAL_VAD_THRESHOLD=0.06
UI_LISTEN_HOLD_SEC=1.6
UI_HUB_RETRY_MS=1500

# ──────────────────────────────────────────────
# [13] SAFETY GATES (see shell_safety_gate.py)
# ──────────────────────────────────────────────
# Evolution / Self-Heal / Sentinel can write LLM-generated Python to disk.
# These operations are DISABLED by default because Gemini output is not
# guaranteed safe. Enable only for a trusted dev session after committing
# your working tree so you can roll back.
#
# Allow create_capability_tool and similar to write new shell_*.py files:
SHELL_ALLOW_CODE_WRITE=0
# Additionally allow mutating agent.py and other core files (implies above):
SHELL_ALLOW_AGENT_PATCH=0

# Allow tool-triggered terminal / PowerShell / inline Python execution:
SHELL_ALLOW_TERMINAL_EXEC=0
# Allow JSON workflows to run shell commands:
SHELL_ALLOW_WORKFLOW_COMMANDS=0
# Allow JSON workflows to write or append files:
SHELL_ALLOW_WORKFLOW_FILE_WRITE=0
# Allow JSON workflows to read local files:
SHELL_ALLOW_WORKFLOW_FILE_READ=0

# External automation integrations remain permission-gated.
# Enables real agent-browser commands from Shell tools. Use dry_run=true to preview.
SHELL_ALLOW_AGENT_BROWSER_EXEC=0
# Short socket directory avoids Unix socket path-length and temp permission issues.
SHELL_AGENT_BROWSER_SOCKET_DIR=/tmp/shell-agent-browser
# Enables OpenClaw skill installation through local clawhub. Review skill source first.
SHELL_ALLOW_OPENCLAW_SKILL_INSTALL=0

# Hub bridge. It binds to loopback by default. Set a token before remote binds.
SHELL_HUB_HOST=127.0.0.1
SHELL_HUB_TOKEN=
SHELL_HUB_ALLOW_UNAUTH_REMOTE=0

# Custom HTTP "MCP" dispatcher. It binds to loopback by default.
SHELL_MCP_HOST=127.0.0.1
SHELL_MCP_PORT=3333
# UI Tools/MCP page uses this URL when calling the dispatcher.
SHELL_MCP_URL=http://127.0.0.1:3333
# Optional bearer token for MCP POST requests. Required for safe remote binds.
SHELL_MCP_TOKEN=
# Emergency override for unauthenticated 0.0.0.0 / :: binds. Keep disabled.
SHELL_MCP_ALLOW_UNAUTH_REMOTE=0

# Downloads are rooted here unless SHELL_ALLOW_ARBITRARY_DOWNLOAD_PATH=1.
SHELL_DOWNLOAD_DIR=shell_downloads
SHELL_ALLOW_ARBITRARY_DOWNLOAD_PATH=0

# ──────────────────────────────────────────────
# [14] OCR / VISION (Tesseract) — Optional
# ──────────────────────────────────────────────
# If Tesseract is installed in a non-standard path, set it here. Leave
# blank to auto-detect common install locations. When not found, Shell
# falls back to Gemini Vision for OCR (slower but works).
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=
